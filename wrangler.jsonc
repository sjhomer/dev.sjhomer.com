{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dev-sjhomer-com",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Production is the custom domain; the *.workers.dev URL stays on as a
  // fallback, and per-version Preview URLs are used by PRs.
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "dev.sjhomer.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
}
